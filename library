local function ensureDirectory(path)
	if not makefolder then return end
	local directory = string.match(path, "^(.*)[/\\][^/\\]+$")
	if not directory or directory == "" then return end
	local current = ""
	for part in string.gmatch(directory, "[^/\\]+") do
		current = current == "" and part or current .. "/" .. part
		if not isfolder or not isfolder(current) then pcall(makefolder, current) end
	end
end

local function cleanConfigName(value)
	local name = tostring(value or "")
	name = string.gsub(name, "%.json$", "")
	name = string.gsub(name, "[^%w_%-]", "")
	return name ~= "" and name or "default"
end

local function configPath(directory, name)
	return (directory or "hydra/configs") .. "/" .. cleanConfigName(name) .. ".json"
end

local function configMarkerPath(directory)
	return (directory or "hydra/configs") .. "/.autoload"
end

local function serializeConfigValue(value)
	if typeof(value) == "EnumItem" then
		local enumName = string.match(tostring(value.EnumType), "^Enum%.(.+)$") or "KeyCode"
		return { __enum = enumName, value = value.Name }
	end
	if type(value) ~= "table" then return value end
	local output = {}
	for key, entry in pairs(value) do output[key] = serializeConfigValue(entry) end
	return output
end

local function deserializeConfigValue(value)
	if type(value) ~= "table" then return value end
	if value.__enum and value.value then
		local enumType = Enum[value.__enum]
		if enumType then
			local ok, item = pcall(function() return enumType[value.value] end)
			if ok and item then return item end
		end
		return value.value
	end
	if value.__enum then
		local ok, item = pcall(function() return Enum.KeyCode[value.__enum] end)
		return ok and item or value.__enum
	end
	local output = {}
	for key, entry in pairs(value) do output[key] = deserializeConfigValue(entry) end
	return output
end

local function ignoredFlagSet(options)
	local ignored = {}
	for key, value in pairs((options and options.IgnoreFlags) or {}) do
		if type(key) == "number" then ignored[value] = true elseif value then ignored[key] = true end
	end
	return ignored
end

function Hydra:ListConfigs(directory)
	directory = directory or "hydra/configs"
	ensureDirectory(directory .. "/placeholder.json")
	if not listfiles then return {} end
	local ok, files = pcall(listfiles, directory)
	if not ok then return {} end
	local configs = {}
	for _, path in ipairs(files) do
		local name = string.match(path, "([^/\\]+)%.json$")
		if name then table.insert(configs, name) end
	end
	table.sort(configs, function(a, b) return string.lower(a) < string.lower(b) end)
	return configs
end

function Hydra:DeleteConfig(fileName)
	if not delfile or not isfile then return false, "filesystem is unavailable" end
	if not isfile(fileName) then return false, "config does not exist" end
	local ok, problem = pcall(delfile, fileName)
	return ok, problem
end

function Hydra:SaveConfig(fileName, options)
	if not writefile then return false, "writefile is unavailable" end
	local path = fileName or "hydra-config.json"
	ensureDirectory(path)
	local ignored = ignoredFlagSet(options)
	local data = {}
	for flag, control in pairs(self.Controls) do
		if not ignored[flag] then data[flag] = serializeConfigValue(control:Get()) end
	end
	local ok, problem = pcall(writefile, path, HttpService:JSONEncode(data))
	return ok, problem
end

function Hydra:LoadConfig(fileName, options)
	if not readfile or not isfile then return false, "filesystem is unavailable" end
	local path = fileName or "hydra-config.json"
	if not isfile(path) then return false, "config does not exist" end
	local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok then return false, decoded end
	local ignored = ignoredFlagSet(options)
	local silent = options and options.CallCallbacks == false
	for flag, value in pairs(decoded) do
		local control = self.Controls[flag]
		if control and not ignored[flag] then
			control:Set(deserializeConfigValue(value), silent)
		end
	end
	return true
end

function Hydra:ResetConfig(options)
	local ignored = ignoredFlagSet(options)
	local silent = options and options.CallCallbacks == false
	for flag, control in pairs(self.Controls) do
		if not ignored[flag] then control:Set(control.Default, silent) end
	end
	return true
end

function Hydra:SetAutoloadConfig(name, directory)
	if not writefile then return false, "writefile is unavailable" end
	directory = directory or "hydra/configs"
	name = cleanConfigName(name)
	local path = configPath(directory, name)
	if isfile and not isfile(path) then return false, "config does not exist" end
	local marker = configMarkerPath(directory)
	ensureDirectory(marker)
	local ok, problem = pcall(writefile, marker, name)
	return ok, problem
end

function Hydra:GetAutoloadConfig(directory)
	if not readfile or not isfile then return nil end
	local marker = configMarkerPath(directory)
	if not isfile(marker) then return nil end
	local ok, value = pcall(readfile, marker)
	if not ok then return nil end
	local name = cleanConfigName(value)
	if not isfile(configPath(directory, name)) then return nil end
	return name
end

function Hydra:ClearAutoloadConfig(directory)
	if not delfile or not isfile then return false, "filesystem is unavailable" end
	local marker = configMarkerPath(directory)
	if not isfile(marker) then return true end
	local ok, problem = pcall(delfile, marker)
	return ok, problem
end

function Hydra:LoadAutoloadConfig(directory, options)
	local name = self:GetAutoloadConfig(directory)
	if not name then return false, "no autoload config" end
	local ok, problem = self:LoadConfig(configPath(directory, name), options)
	return ok, problem, name
end

function Hydra:DuplicateConfig(directory, sourceName, targetName)
	if not readfile or not writefile or not isfile then return false, "filesystem is unavailable" end
	local source = configPath(directory, sourceName)
	local target = configPath(directory, targetName)
	if not isfile(source) then return false, "source config does not exist" end
	if isfile(target) then return false, "target config already exists" end
	ensureDirectory(target)
	local ok, problem = pcall(writefile, target, readfile(source))
	return ok, problem
end

function Hydra:RenameConfig(directory, sourceName, targetName)
	if not delfile then return false, "delfile is unavailable" end
	local wasAutoload = self:GetAutoloadConfig(directory) == cleanConfigName(sourceName)
	local ok, problem = self:DuplicateConfig(directory, sourceName, targetName)
	if not ok then return false, problem end
	local source = configPath(directory, sourceName)
	local removed, removeProblem = pcall(delfile, source)
	if not removed then
		pcall(delfile, configPath(directory, targetName))
		return false, removeProblem
	end
	if wasAutoload then
		self:SetAutoloadConfig(targetName, directory)
	end
	return true
end

function Hydra:CreateConfigManager(section, options)
	options = merge({
		Directory = "hydra/configs",
		DefaultName = "default",
		FlagPrefix = "hydra.config",
		Notify = true,
	}, options)
	local directory = options.Directory
	local prefix = options.FlagPrefix
	local internalFlags = {
		prefix .. ".name",
		prefix .. ".selected",
		prefix .. ".autoload",
	}
	local ignored = {}
	for _, flag in ipairs(internalFlags) do ignored[flag] = true end
	for key, value in pairs(options.IgnoreFlags or {}) do
		if type(key) == "number" then ignored[value] = true elseif value then ignored[key] = true end
	end
	local saveOptions = { IgnoreFlags = ignored }
	local manager = { Directory = directory, IgnoreFlags = ignored }

	local function notify(title, message)
		if options.Notify then self:Notify({ Title = title, Message = tostring(message or "") }) end
	end

	manager.Name = section:AddInput({
		Name = options.NameLabel or "Config name",
		Flag = internalFlags[1],
		Default = options.DefaultName,
		Finished = true,
	})
	manager.Selected = section:AddDropdown({
		Name = options.ListLabel or "Saved configs",
		Flag = internalFlags[2],
		Values = self:ListConfigs(directory),
		Expandable = false,
		EmptyText = "No saved configs",
		Callback = function(name)
			if name then manager.Name:Set(name, true) end
			if manager.Autoload then manager.Autoload:Set(Hydra:GetAutoloadConfig(directory) == name, true) end
		end,
	})

	function manager:Refresh(preferred)
		local configs = Hydra:ListConfigs(directory)
		self.Selected:SetValues(configs, true)
		local wanted = preferred or self.Selected:Get()
		if wanted and table.find(configs, wanted) then self.Selected:Set(wanted, true) end
		local autoloadName = Hydra:GetAutoloadConfig(directory)
		self.Autoload:Set(autoloadName ~= nil and autoloadName == self.Selected:Get(), true)
		return configs
	end

	function manager:Save(overwrite)
		local selected = self.Selected:Get()
		if overwrite and not selected then return false, "select a saved config" end
		local name = cleanConfigName(overwrite and selected or self.Name:Get())
		local path = configPath(directory, name)
		if not overwrite and isfile and isfile(path) then return false, "config already exists" end
		local ok, problem = Hydra:SaveConfig(path, saveOptions)
		if ok then self.Name:Set(name, true) self:Refresh(name) end
		return ok, problem, name
	end

	function manager:Load(name)
		name = name or self.Selected:Get()
		if not name then return false, "select a saved config" end
		name = cleanConfigName(name)
		local ok, problem = Hydra:LoadConfig(configPath(directory, name), saveOptions)
		if ok then self.Name:Set(name, true) self:Refresh(name) end
		return ok, problem, name
	end

	function manager:Delete()
		local name = self.Selected:Get()
		if not name then return false, "select a saved config" end
		if Hydra:GetAutoloadConfig(directory) == name then Hydra:ClearAutoloadConfig(directory) end
		local ok, problem = Hydra:DeleteConfig(configPath(directory, name))
		if ok then self:Refresh() end
		return ok, problem, name
	end

	manager.Autoload = section:AddToggle({
		Name = options.AutoloadLabel or "Autoload selected",
		Flag = internalFlags[3],
		Default = false,
		Callback = function(enabled)
			local name = manager.Selected:Get()
			local ok, problem
			if enabled then
				if not name then manager.Autoload:Set(false, true) notify("Autoload failed", "select a saved config") return end
				ok, problem = self:SetAutoloadConfig(name, directory)
			else
				ok, problem = self:ClearAutoloadConfig(directory)
			end
			if not ok then manager.Autoload:Set(not enabled, true) notify("Autoload failed", problem) end
		end,
	})

	section:AddButton({ Name = "Save new config", ButtonText = "SAVE", Callback = function()
		local ok, problem, name = manager:Save(false)
		notify(ok and "Configuration saved" or "Save failed", ok and name or problem)
	end })
	section:AddButton({ Name = "Load selected", ButtonText = "LOAD", Callback = function()
		local ok, problem, name = manager:Load()
		notify(ok and "Configuration loaded" or "Load failed", ok and name or problem)
	end })
	section:AddButton({ Name = "Overwrite selected", ButtonText = "WRITE", Callback = function()
		local ok, problem, name = manager:Save(true)
		notify(ok and "Configuration overwritten" or "Overwrite failed", ok and name or problem)
	end })
	section:AddButton({ Name = "Duplicate as name", ButtonText = "COPY", Callback = function()
		local source = manager.Selected:Get()
		local target = cleanConfigName(manager.Name:Get())
		local ok, problem
		if source then ok, problem = Hydra:DuplicateConfig(directory, source, target) else ok, problem = false, "select a saved config" end
		if ok then manager:Refresh(target) end
		notify(ok and "Configuration duplicated" or "Duplicate failed", ok and target or problem)
	end })
	section:AddButton({ Name = "Rename to name", ButtonText = "RENAME", Callback = function()
		local source = manager.Selected:Get()
		local target = cleanConfigName(manager.Name:Get())
		local ok, problem
		if source then ok, problem = Hydra:RenameConfig(directory, source, target) else ok, problem = false, "select a saved config" end
		if ok then manager:Refresh(target) end
		notify(ok and "Configuration renamed" or "Rename failed", ok and target or problem)
	end })
	section:AddButton({ Name = "Delete selected", ButtonText = "DELETE", Danger = true, Callback = function()
		local ok, problem, name = manager:Delete()
		notify(ok and "Configuration deleted" or "Delete failed", ok and name or problem)
	end })
	section:AddButton({ Name = "Reset controls", ButtonText = "RESET", Callback = function()
		Hydra:ResetConfig(saveOptions)
		notify("Controls reset", "Defaults restored")
	end })
	section:AddButton({ Name = "Refresh config list", ButtonText = "REFRESH", Callback = function()
		local configs = manager:Refresh()
		notify("Config list refreshed", tostring(#configs) .. " saved")
	end })

	manager:Refresh(self:GetAutoloadConfig(directory))
	return manager
end

