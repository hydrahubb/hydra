local function make(className, properties, children)
	local object = Instance.new(className)
	for key, value in pairs(properties or {}) do object[key] = value end
	for _, child in ipairs(children or {}) do child.Parent = object end
	return object
end

local function corner(radius)
	return make("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function stroke(color, transparency, thickness)
	return make("UIStroke", {
		Color = color or C.Line,
		Transparency = transparency or 0,
		Thickness = thickness or 1,
	})
end

local function padding(left, right, top, bottom)
	return make("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingRight = UDim.new(0, right or left or 0),
		PaddingTop = UDim.new(0, top or left or 0),
		PaddingBottom = UDim.new(0, bottom or top or left or 0),
	})
end

local function merge(defaults, supplied)
	local output = {}
	for key, value in pairs(defaults) do output[key] = value end
	for key, value in pairs(supplied or {}) do output[key] = value end
	return output
end

local function animate(instance, duration, properties)
	local tween = TweenService:Create(instance, TweenInfo.new(duration or 0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), properties)
	tween:Play()
	return tween
end

local function safeCall(callback, ...)
	if type(callback) ~= "function" then return end
	local ok, problem = pcall(callback, ...)
	if not ok then warn("[Hydra] callback error:", problem) end
end

local function environment()
