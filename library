function Hydra:Notify(options)
	options = merge({ Title = "Hydra", Message = "Ready", Duration = 3 }, options)
	local record = {
		Title = tostring(options.Title),
		Message = tostring(options.Message),
		Time = os.date("%I:%M %p"),
		Timestamp = os.time(),
	}
	table.insert(self.NotificationHistory, 1, record)
	if #self.NotificationHistory > 50 then table.remove(self.NotificationHistory) end
	for _, window in ipairs(self.Windows) do
		if not window.NotificationsOpen then
			window.UnreadNotifications = (window.UnreadNotifications or 0) + 1
			window:_refreshNotificationBadge()
		end
		if window.NotificationsOpen then window:_refreshNotifications() end
