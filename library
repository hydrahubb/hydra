local function bindButtonFeedback(button, cleaner, normalColor)
	local hoverColor = normalColor:Lerp(Color3.new(1, 1, 1), 0.07)
	local pressedColor = normalColor:Lerp(C.Canvas, 0.16)
	cleaner:Add(button.MouseEnter:Connect(function()
		animate(button, 0.1, { BackgroundColor3 = hoverColor })
	end))
	cleaner:Add(button.MouseLeave:Connect(function()
		animate(button, 0.1, { BackgroundColor3 = normalColor })
	end))
	cleaner:Add(button.MouseButton1Down:Connect(function()
		animate(button, 0.06, { BackgroundColor3 = pressedColor })
	end))
	cleaner:Add(button.MouseButton1Up:Connect(function()
		animate(button, 0.08, { BackgroundColor3 = hoverColor })
	end))
end

local function makeDraggable(handle, target, cleaner)
	local dragging = false
	local origin
	local start
	cleaner:Add(handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			origin = input.Position
			start = target.Position
		end
	end))
	cleaner:Add(UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = input.Position - origin
		target.Position = UDim2.new(start.X.Scale, start.X.Offset + delta.X, start.Y.Scale, start.Y.Offset + delta.Y)
	end))
	cleaner:Add(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end))
end

