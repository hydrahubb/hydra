local Control = {}
Control.__index = Control

function Control:Get()
	return self.Value
end

function Control:_commit(value, silent)
	self.Value = value
	if self.Flag then Hydra.Flags[self.Flag] = value end
	if not silent then safeCall(self.Callback, value) end
end

