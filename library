function Window:SetMinimized(minimized)
	if self.Minimized == minimized then return end
	self.Minimized = minimized
	if minimized and self.NotificationsOpen then self:SetNotificationsOpen(false) end
	self.MinimizeToken = (self.MinimizeToken or 0) + 1
	local token = self.MinimizeToken
	local function contentVisible(visible)
		self.Nav.Visible = visible
		self.Pages.Visible = visible
		self.MainHeader.Visible = visible
		self.SeparatorOverlay.Visible = visible
		self.MinimizeButton.Visible = visible
		self.NotificationButton.Visible = visible
		self.BrandTitle.Visible = visible
		self.BrandSubtitle.Visible = visible and self.HasSubtitle
	end
	if minimized then
		self.ExpandedPosition = self.Root.Position
		contentVisible(false)
		self.RootStroke.Transparency = 0
		self.RestoreHitbox.Visible = true
		self.Sidebar.Size = UDim2.fromScale(1, 1)
		self.Brand.Size = UDim2.fromScale(1, 1)
		local position = self.ExpandedPosition
		local iconPosition = UDim2.new(position.X.Scale, position.X.Offset - 358, position.Y.Scale, position.Y.Offset - 278)
		animate(self.Logo, 0.2, { Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(52, 52) })
		animate(self.RootCorner, 0.22, { CornerRadius = UDim.new(0, 18) })
		animate(self.Root, 0.24, { Position = iconPosition, Size = UDim2.fromOffset(64, 64) })
	else
		self.RestoreHitbox.Visible = false
		self.RootStroke.Transparency = 1
		animate(self.Logo, 0.2, { Position = UDim2.fromOffset(10, 7), Size = UDim2.fromOffset(48, 48) })
		animate(self.RootCorner, 0.22, { CornerRadius = UDim.new(0, 14) })
		animate(self.Root, 0.24, { Position = self.ExpandedPosition or centeredPixelPosition(), Size = UDim2.fromOffset(780, 620) })
		task.delay(0.25, function()
			if self.MinimizeToken ~= token or self.Minimized then return end
			self.Sidebar.Size = UDim2.new(0, 226, 1, 0)
			self.Brand.Size = UDim2.new(0, 226, 0, 62)
			contentVisible(true)
		end)
	end
end

