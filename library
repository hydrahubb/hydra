function Section:AddSlider(options)
	options = merge({ Name = "Slider", Min = 0, Max = 100, Step = 1, Default = 50, Suffix = "" }, options)
	local stepText = tostring(options.Step)
	local decimalPoint = string.find(stepText, ".", 1, true)
	local precision = decimalPoint and (#stepText - decimalPoint) or 0
	local precisionScale = 10 ^ precision
	local row = self:_row(68, options)
	local title = addTextPair(row, { Name = options.Name }, 70)
	title.Position = UDim2.fromOffset(11, 3)
	title.Size = UDim2.new(1, -80, 0, 20)
	local valueLabel = make("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -10, 0, 4),
		Size = UDim2.fromOffset(64, 18),
		Font = Enum.Font.Code,
		TextColor3 = C.Muted,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	valueLabel.Parent = row
	local track = make("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = C.Line,
		Position = UDim2.fromOffset(10, 39),
		Size = UDim2.new(1, -20, 0, 7),
		Text = "",
	}, { corner(4) })
	track.Parent = row
	local fill = make("Frame", { BackgroundColor3 = C.Accent, Size = UDim2.fromScale(0, 1) }, { corner(4) })
	fill.Parent = track
	local knob = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = C.Surface,
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(17, 17),
	}, { corner(9), stroke(C.Accent, 0) })
	knob.Parent = track
	local control = self:_control(options, options.Default)
	control.Instance = row
	function control:Set(value, silent)
		value = math.clamp(tonumber(value) or options.Min, options.Min, options.Max)
		value = math.floor(((value - options.Min) / options.Step) + 0.5) * options.Step + options.Min
		value = math.floor(value * precisionScale + 0.5) / precisionScale
		value = math.clamp(value, options.Min, options.Max)
		local ratio = options.Max == options.Min and 0 or (value - options.Min) / (options.Max - options.Min)
		self:_commit(value, silent)
		valueLabel.Text = string.format("%." .. precision .. "f", value) .. options.Suffix
		fill.Size = UDim2.fromScale(ratio, 1)
		knob.Position = UDim2.fromScale(ratio, 0.5)
	end
	local dragging = false
	local function update(input)
		local ratio = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		control:Set(options.Min + (options.Max - options.Min) * ratio)
	end
	self.Window.Cleaner:Add(track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true update(input) end
	end))
	self.Window.Cleaner:Add(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
	end))
	self.Window.Cleaner:Add(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end))
	control:Set(options.Default, true)
	return control
end

