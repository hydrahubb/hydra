			refreshModal()
			if not multi then dismiss() end
		end))
	end
	refreshModal()
	self.Cleaner:Add(close.Activated:Connect(dismiss))
	self.Cleaner:Add(blocker.Activated:Connect(dismiss))
	animate(layer, 0.18, { GroupTransparency = 0 })
