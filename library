		if options.Multi then
			local picked = {}
			for _, value in ipairs(options.Values) do if control.Value[value] then table.insert(picked, tostring(value)) end end
			fieldLabel.Text = #picked == 0 and "Select..." or (#picked <= 2 and table.concat(picked, ", ") or tostring(#picked) .. " selected")
		else
			fieldLabel.Text = tostring(control.Value or options.EmptyText)
		end
		for value, choice in pairs(control.Choices) do
			local active = selected(value)
			choice.BackgroundColor3 = active and C.AccentSoft or C.Surface
			local mark = choice:FindFirstChild("SelectionMark")
			if mark then
				mark.BackgroundColor3 = active and C.Accent or C.SurfaceAlt
				local shortStroke = mark:FindFirstChild("ShortStroke")
				local longStroke = mark:FindFirstChild("LongStroke")
				if shortStroke then shortStroke.Visible = active end
				if longStroke then longStroke.Visible = active end
			end
		end
	end

	function control:Set(value, silent)
		if options.Multi then
			local normalized = {}
			if type(value) == "table" then
				for key, enabled in pairs(value) do
					if type(key) == "number" then normalized[enabled] = true elseif enabled then normalized[key] = true end
				end
			end
			value = normalized
		end
		self:_commit(value, silent)
		refresh()
	end

	function control:ToggleValue(value)
		if options.Multi then
			local nextValue = {}
			for key, enabled in pairs(self.Value) do nextValue[key] = enabled end
			nextValue[value] = not nextValue[value]
			if not nextValue[value] then nextValue[value] = nil end
			self:Set(nextValue)
		else
			self:Set(value)
			self:SetOpen(false)
		end
	end

	function control:SetOpen(open)
		if open and #options.Values == 0 then
			self.Open = false
			return
		end
		self.Open = open
		local visibleCount = math.min(#options.Values, 6)
		local listHeight = visibleCount * 30
		listFrame.Size = UDim2.new(1, 0, 0, listHeight)
		animate(chevron, 0.16, { Rotation = open and 180 or 0 })
		if open then
			listFrame.Visible = true
			animate(surface, 0.18, { Size = UDim2.new(1, -16, 0, 30 + listHeight) })
			animate(row, 0.18, { Size = UDim2.new(1, 0, 0, 68 + listHeight) })
		else
			animate(surface, 0.15, { Size = UDim2.new(1, -16, 0, 30) })
			animate(row, 0.15, { Size = UDim2.new(1, 0, 0, 68) })
			task.delay(0.16, function()
				if not self.Open then listFrame.Visible = false end
			end)
		end
	end

	local function rebuildChoices()
		for _, choice in pairs(control.Choices) do choice:Destroy() end
		table.clear(control.Choices)
		for _, value in ipairs(options.Values) do
			local choice = make("TextButton", {
				AutoButtonColor = false,
				BackgroundColor3 = C.Surface,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 30),
				Text = "",
			})
			choice.Parent = listFrame
			local separator = make("Frame", {
				BackgroundColor3 = C.Line,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 1),
			})
			separator.Parent = choice
			local choiceLabel = make("TextLabel", {
				BackgroundTransparency = 1,
				Font = Enum.Font.Code,
				Name = "ChoiceLabel",
				Position = UDim2.fromOffset(10, 1),
				Size = UDim2.new(1, options.Multi and -44 or -20, 1, -1),
				Text = tostring(value),
				TextColor3 = C.Text,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
			})
			choiceLabel.Parent = choice
			if options.Multi then
				local mark = make("Frame", {
					AnchorPoint = Vector2.new(1, 0.5),
					BackgroundColor3 = C.SurfaceAlt,
					Name = "SelectionMark",
					Position = UDim2.new(1, -7, 0.5, 0),
					Size = UDim2.fromOffset(18, 18),
				}, { corner(5), stroke(C.LineStrong, 0.2) })
				mark.Parent = choice
				local shortStroke = make("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundColor3 = Color3.new(1, 1, 1),
					BorderSizePixel = 0,
					Name = "ShortStroke",
					Position = UDim2.fromOffset(6, 10),
					Rotation = -45,
					Size = UDim2.fromOffset(2, 7),
					Visible = false,
				}, { corner(1) })
				shortStroke.Parent = mark
				local longStroke = make("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundColor3 = Color3.new(1, 1, 1),
					BorderSizePixel = 0,
					Name = "LongStroke",
					Position = UDim2.fromOffset(11, 8),
					Rotation = 45,
					Size = UDim2.fromOffset(2, 10),
					Visible = false,
				}, { corner(1) })
				longStroke.Parent = mark
			end
			control.Choices[value] = choice
			self.Window.Cleaner:Add(choice.Activated:Connect(function() control:ToggleValue(value) end))
		end
		refresh()
	end

	function control:SetValues(values, preserveSelection)
		self:SetOpen(false)
		options.Values = table.clone(values or {})
		local nextValue
		if options.Multi then
			nextValue = {}
			if preserveSelection then
				for _, value in ipairs(options.Values) do if self.Value[value] then nextValue[value] = true end end
			end
		elseif preserveSelection and table.find(options.Values, self.Value) then
			nextValue = self.Value
		else
			nextValue = options.Values[1]
		end
		self:_commit(nextValue, true)
		rebuildChoices()
	end

	rebuildChoices()

	self.Window.Cleaner:Add(field.Activated:Connect(function() control:SetOpen(not control.Open) end))
	self.Window.Cleaner:Add(chevron.Activated:Connect(function() control:SetOpen(not control.Open) end))
	if options.Expandable then
		self.Window.Cleaner:Add(expandButton.Activated:Connect(function()
			self.Window:_openDropdownModal(options.Name, options.Values, options.Multi, control)
		end))
	end
	control:Set(initial, true)
	return control
end

