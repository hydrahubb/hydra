end

local function centeredPixelPosition()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	return UDim2.fromOffset(math.floor(viewport.X * 0.5 + 0.5), math.floor(viewport.Y * 0.5 + 0.5))
end

