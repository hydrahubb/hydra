end

function Section:_row(height, options)
	local row = make("Frame", {
		BackgroundColor3 = C.SurfaceAlt,
		Size = UDim2.new(1, 0, 0, height),
		ClipsDescendants = true,
	}, { corner(7), stroke(C.Line, 0.35) })
	row.Parent = self.Body
	self:_register(row, options or {})
	return row
end

function Section:_control(options, default)
	local control = setmetatable({
		Flag = options.Flag or options.Id,
		Callback = options.Callback,
		Default = default,
		Value = default,
		Window = self.Window,
	}, Control)
	if control.Flag then Hydra.Controls[control.Flag] = control end
	return control
end

