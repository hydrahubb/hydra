	window.Cleaner:Add(notificationButton.Activated:Connect(function()
		window:SetNotificationsOpen(not window.NotificationsOpen)
	end))
	window.Cleaner:Add(clearNotifications.Activated:Connect(function()
		table.clear(Hydra.NotificationHistory)
		for _, openWindow in ipairs(Hydra.Windows) do
			openWindow.UnreadNotifications = 0
			openWindow:_refreshNotificationBadge()
			openWindow:_refreshNotifications()
		end
	end))
	bindButtonFeedback(clearNotifications, window.Cleaner, C.SurfaceAlt)
	window.Cleaner:Add(minimizeButton.Activated:Connect(function() window:SetMinimized(true) end))
	window:_refreshNotifications()
	window:_refreshNotificationBadge()
	local iconDragging = false
	local iconMoved = false
	local iconOrigin
	local iconStart
	window.Cleaner:Add(restoreHitbox.InputBegan:Connect(function(input)
		if not window.Minimized then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			iconDragging = true
			iconMoved = false
			iconOrigin = input.Position
			iconStart = root.Position
		end
	end))
	window.Cleaner:Add(UserInputService.InputChanged:Connect(function(input)
		if not iconDragging or not window.Minimized then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = input.Position - iconOrigin
		if delta.Magnitude >= 4 then iconMoved = true end
		root.Position = UDim2.new(iconStart.X.Scale, iconStart.X.Offset + delta.X, iconStart.Y.Scale, iconStart.Y.Offset + delta.Y)
	end))
	window.Cleaner:Add(UserInputService.InputEnded:Connect(function(input)
		if not iconDragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		iconDragging = false
		if iconMoved then
			local position = root.Position
			window.ExpandedPosition = UDim2.new(position.X.Scale, position.X.Offset + 358, position.Y.Scale, position.Y.Offset + 278)
		else
			window:SetMinimized(false)
		end
	end))
	window.Cleaner:Add(UserInputService.InputBegan:Connect(function(input, processed)
		if window.CapturingKeybind then
			if input.KeyCode ~= Enum.KeyCode.Unknown then
				local capture = window.CapturingKeybind window.CapturingKeybind = nil capture:Set(input.KeyCode)
			end
			return
		end
		if processed then return end
		if input.KeyCode == window.ToggleKey then
			if window.Minimized then window:SetMinimized(false) else window:Toggle() end
		end
		for _, control in pairs(Hydra.Controls) do
			if typeof(control.Value) == "EnumItem" and control.Value == input.KeyCode then safeCall(control.Callback, input.KeyCode) end
		end
	end))
	task.defer(function()
		animate(root, 0.24, { GroupTransparency = 0 })
		animate(windowScale, 0.28, { Scale = 1 })
		animate(separatorScale, 0.28, { Scale = 1 })
	end)
	return window
end

function Hydra:GetExecutorInfo()
	local name, version
	if type(identifyexecutor) == "function" then
		local ok, detectedName, detectedVersion = pcall(identifyexecutor)
		if ok then name, version = detectedName, detectedVersion end
	elseif type(getexecutorname) == "function" then
		local ok, detectedName = pcall(getexecutorname)
		if ok then name = detectedName end
	end
	if not name or tostring(name) == "" then
		if syn then name = "Synapse" elseif KRNL_LOADED then name = "KRNL" elseif fluxus then name = "Fluxus" elseif gethui then name = "Unknown (gethui)" else name = "Unknown" end
	end
	name = tostring(name)
	version = version and tostring(version) or nil
	return {
		Name = name,
		Version = version,
		Display = version and version ~= "" and (name .. " " .. version) or name,
	}
end

function Hydra:CreateUniversalInfo(window, options)
	options = merge({
		TabName = "Info",
		TabIcon = "Info",
		GameTitle = game.Name,
		DiscordInvite = self.DiscordInvite,
		Features = {},
		Changelog = {},
	}, options)
	local player = Players.LocalPlayer
	local executor = self:GetExecutorInfo()
	local tab = window:AddTab(options.TabName, options.TabIcon)

	local function lines(value, empty)
		if type(value) == "string" then return value end
		if type(value) ~= "table" or next(value) == nil then return empty or "None" end
		local output = {}
		for _, entry in ipairs(value) do table.insert(output, tostring(entry)) end
		return table.concat(output, "\n")
	end

	local function copyText(value, label)
		if type(setclipboard) ~= "function" then
			self:Notify({ Title = "Clipboard unavailable", Message = label })
			return false
		end
		local ok = pcall(setclipboard, tostring(value))
		self:Notify({ Title = ok and "Copied" or "Copy failed", Message = label })
		return ok
	end

	local discord = tab:AddSection("Discord", { Side = "Left", Icon = "Link" })
	discord:AddButton({ Name = "Copy invite", ButtonText = "COPY", Callback = function()
		copyText(options.DiscordInvite, "Discord invite")
	end })

	local account = tab:AddSection("Account", { Side = "Left", Icon = "Account" })
	account:AddParagraph({
		Name = player.DisplayName,
		Content = table.concat({
			"Username  -  " .. player.Name,
			"User ID  -  " .. tostring(player.UserId),
			"Account age  -  " .. tostring(player.AccountAge) .. " days",
			"Executor  -  " .. executor.Display,
		}, "\n"),
	})
	account:AddButton({ Name = "Copy username", ButtonText = "COPY", Callback = function()
		copyText(player.Name, "Username")
	end })

	local gameInfo = tab:AddSection("Game Info", { Side = "Left", Icon = "Box" })
	gameInfo:AddParagraph({
		Name = options.GameTitle,
		Content = table.concat({
			"Place ID  -  " .. tostring(game.PlaceId),
			"Universe ID  -  " .. tostring(game.GameId),
			"Session  -  Live",
			"Server  -  Connected",
		}, "\n"),
	})
	gameInfo:AddButton({ Name = "Copy place ID", ButtonText = "COPY", Callback = function()
		copyText(game.PlaceId, "Place ID")
	end })

	local features = tab:AddSection(options.FeaturesTitle or "Features", { Side = "Right", Icon = "Sparkle" })
	features:AddParagraph({ Name = options.FeaturesHeading or "Included", Content = lines(options.Features, "No features listed") })

	local changelog = tab:AddSection(options.ChangelogTitle or "Changelog", { Side = "Right", Icon = "List" })
	changelog:AddParagraph({ Name = options.VersionLabel or ("Hydra " .. self.Version), Content = lines(options.Changelog, "No changes listed") })

	local actions = tab:AddSection("Actions", { Side = "Right", Icon = "Link" })
	actions:AddButton({ Name = "Copy job ID", ButtonText = "COPY", Callback = function()
		copyText(game.JobId, "Job ID")
	end })
	actions:AddButton({ Name = "Copy game ID", ButtonText = "COPY", Callback = function()
		copyText(game.GameId, "Universe ID")
	end })

	return {
		Tab = tab,
		Discord = discord,
		Account = account,
		Game = gameInfo,
		Features = features,
		Changelog = changelog,
		Actions = actions,
		Executor = executor,
	}
end

function Hydra:Destroy()
	self.Cleaner:Clean()
	table.clear(self.Windows)
	table.clear(self.Controls)
	table.clear(self.Flags)
	table.clear(self.NotificationHistory)
	local env = environment()
	if env.__HYDRA_LIBRARY == self then env.__HYDRA_LIBRARY = nil end
end

do
	local env = environment()
	if env.__HYDRA_LIBRARY and env.__HYDRA_LIBRARY.Destroy then pcall(function() env.__HYDRA_LIBRARY:Destroy() end) end
	local parent = guiParent()
	local old = parent:FindFirstChild(GUI_NAME)
	if old then old:Destroy() end
	local screen = make("ScreenGui", {
		Name = GUI_NAME, DisplayOrder = 999999, IgnoreGuiInset = true, ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	if syn and syn.protect_gui then pcall(syn.protect_gui, screen) end
	screen.Parent = parent
	Hydra.ScreenGui = screen
	Hydra.Cleaner:Add(screen)
	local notifications = make("Frame", {
		AnchorPoint = Vector2.new(1, 1), BackgroundTransparency = 1,
		Position = UDim2.new(1, -18, 1, -18), Size = UDim2.fromOffset(304, 430),
	}, { make("UIListLayout", { HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom }) })
	notifications.Parent = screen
	Hydra.NotificationHolder = notifications
	env.__HYDRA_LIBRARY = Hydra
end

return Hydra
