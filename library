	grid.Parent = panel
	local modalChoices = {}
	local function refreshModal()
		for value, choice in pairs(modalChoices) do
			local active = multi and control.Value[value] == true or control.Value == value
			choice.BackgroundColor3 = active and C.Accent or C.SurfaceAlt
			choice.TextColor3 = active and Color3.new(1, 1, 1) or C.Text
