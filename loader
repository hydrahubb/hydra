--!nocheck

if not game:IsLoaded() then
	game.Loaded:Wait()
end

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local SUPPORTED_GAMES = {
	["10298144467"] = "https://raw.githubusercontent.com/hydrahubb/hydra/refs/heads/main/rollanimetofight",
}

local payloadUrl = SUPPORTED_GAMES[tostring(game.GameId)]
if not payloadUrl then
	LocalPlayer:Kick("GAME NOT SUPPORTED")
	return
end

local fetchSuccess, source = pcall(game.HttpGet, game, payloadUrl)
if not fetchSuccess then
	warn("Hydra failed to fetch the supported-game payload: " .. tostring(source))
	return
end

local payload, compileError = loadstring(source, "@Hydra/UniversalPayload")
if not payload then
	warn("Hydra failed to compile the supported-game payload: " .. tostring(compileError))
	return
end

local runSuccess, result = pcall(payload)
if not runSuccess then
	warn("Hydra supported-game payload failed: " .. tostring(result))
	return
end

return result
