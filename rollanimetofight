local function hasFastSummon()
	if LocalPlayer:GetAttribute("FastSummon") == true then return true end
	local now = workspace:GetServerTimeNow()
	local rawPlayerEnd = LocalPlayer:GetAttribute("FastRollEndsAt")
	local rawWorkspaceEnd = workspace:GetAttribute("FastRollEndsAt")
	local playerEnd = tonumber(rawPlayerEnd) or 0
	local workspaceEnd = tonumber(rawWorkspaceEnd) or 0
	return now < playerEnd or now < workspaceEnd
end

local function serverSummonCooldown()
