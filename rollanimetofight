task.spawn(function()
	while Runtime.Alive do
		local workerOk, workerProblem = xpcall(function()
			if flag("summon.enabled", false) then
				local blocked = Runtime:IsTravelBusy()
				blocked = blocked or (flag("summon.pauseWhileFighting", true) and isFighting())
				blocked = blocked or (flag("summon.stopFull", true) and inventoryFull(numberFlag("buy.inventoryBuffer", 0)))
				if not blocked and os.clock() >= Runtime.NextRollAt then
					Runtime.NextRollAt = os.clock() + summonCooldown() + (flag("buy.enabled", false) and 0.35 or 0.05)
					local ok, problem = fireSummonPrompt()
					if not ok then
						Runtime.NextRollAt = os.clock() + 1
						warn("Hydra summon failed: " .. tostring(problem))
					end
				end
			end
		end, function(problem) return debug.traceback(tostring(problem), 2) end)
		if not workerOk then
			Runtime.Stats.SummonFailures += 1
			Runtime.NextRollAt = os.clock() + 1
			warn("Hydra summon worker recovered (" .. tostring(Runtime.SummonStage) .. "): " .. tostring(workerProblem))
		end
		task.wait(0.1)
	end
end)

task.spawn(function()
	local nextStart = 0
	while Runtime.Alive do
		local stopWave = math.max(0, numberFlag("fight.stopWave", 0))
		local wave = tonumber(LocalPlayer:GetAttribute("FightWave")) or 0
		if stopWave > 0 and isFighting() and wave >= stopWave then
			FightRemote:FireServer("Stop")
			nextStart = os.clock() + 5
		elseif flag("fight.autoStart", false) and not isFighting() and os.clock() >= nextStart then
			FightRemote:FireServer("Start")
			Runtime.Stats.FightStarts += 1
			nextStart = os.clock() + math.max(0.5, numberFlag("fight.startDelay", 2))
		end
		task.wait(0.25)
	end
end)

