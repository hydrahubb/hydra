local env = (getgenv and getgenv()) or _G
local function loadHydraDependency(fileName)
    local baseUrl = tostring(env.HYDRA_BASE_URL or "")
    if baseUrl ~= "" then
        local separator = string.sub(baseUrl, -1) == "/" and "" or "/"
        return assert(loadstring(game:HttpGet(baseUrl .. separator .. fileName), "@Hydra/" .. fileName))()
    end
    local directory = tostring(env.HYDRA_DIST_PATH or "hydra/dist")
    return assert(loadstring(assert(readfile(directory .. "/" .. fileName), fileName .. " could not be read"), "@Hydra/" .. fileName))()
end

if not env.__HYDRA_LIBRARY then
    assert(loadstring(game:HttpGet("https://raw.githubusercontent.com/hydrahubb/hydra/refs/heads/main/library"), "@Hydra/Library"))()
end
