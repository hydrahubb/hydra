local function getPlayerPlot()
	local plots = workspace:FindFirstChild("Plots")
	if not plots then return nil end
	if Runtime.LocalPlot and Runtime.LocalPlot.Parent == plots then
		local owner = Runtime.LocalPlot:GetAttribute("Owner")
		local rawOwnerId = Runtime.LocalPlot:GetAttribute("FightOwnerUserId")
		local ownerId = tonumber(rawOwnerId)
		if owner == LocalPlayer.Name or ownerId == LocalPlayer.UserId then return Runtime.LocalPlot end
		Runtime.LocalPlot = nil
	end
	for _, plot in ipairs(plots:GetChildren()) do
		local owner = plot:GetAttribute("Owner")
		local rawOwnerId = plot:GetAttribute("FightOwnerUserId")
		local ownerId = tonumber(rawOwnerId)
		if owner == LocalPlayer.Name or ownerId == LocalPlayer.UserId then
			Runtime.LocalPlot = plot
			return plot
		end
	end
end

local function getSummonPrompt()
	Runtime.SummonStage = "ResolvePlot"
	local plot = getPlayerPlot()
	Runtime.SummonStage = "FindPrompt"
	local prompt = plot and plot:FindFirstChild("RollPrompt", true)
	return prompt and prompt:IsA("ProximityPrompt") and prompt or nil
end

local function getSummonSpawn()
	local plot = getPlayerPlot()
	local misc = plot and plot:FindFirstChild("Misc")
	local spawn = misc and misc:FindFirstChild("Spawn")
	if spawn and (spawn:IsA("Attachment") or spawn:IsA("BasePart")) then return spawn end
end

local function moveIntoSummonRange(prompt)
	Runtime.SummonStage = "ResolveMovement"
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local button = prompt.Parent
	local spawn = getSummonSpawn()
	if not root or not button or not button:IsA("BasePart") or not spawn then return false, "summon spawn unavailable" end
	if (root.Position - button.Position).Magnitude <= math.max(1, prompt.MaxActivationDistance - 0.5) then
		Runtime.SummonStage = "InRange"
		return true
	end

	local spawnPosition = spawn:IsA("Attachment") and spawn.WorldPosition or spawn.Position
	local target = spawnPosition + Vector3.new(0, 3, 0)
	local offset = button.Position - target
	local safeRange = math.max(2, prompt.MaxActivationDistance - 2)
	if offset.Magnitude > safeRange then target += offset.Unit * (offset.Magnitude - safeRange) end
	local facing = Vector3.new(button.Position.X, target.Y, button.Position.Z)
	root.CFrame = CFrame.lookAt(target, facing)
	task.wait(0.12)
	Runtime.SummonStage = "Positioned"
	return (root.Position - button.Position).Magnitude <= prompt.MaxActivationDistance, "summon prompt remained out of range"
end

local function fireSummonPrompt()
	Runtime.SummonStage = "ResolvePrompt"
	local prompt = getSummonPrompt()
	if not prompt or not prompt.Enabled then return false, "summon prompt unavailable" end
	Runtime.SummonStage = "MoveIntoRange"
	local positioned, positionProblem = moveIntoSummonRange(prompt)
	if not positioned then return false, positionProblem end
	Runtime.SummonStage = "IncrementAttempt"
	Runtime.Stats.SummonAttempts += 1

	if type(fireproximityprompt) == "function" then
		Runtime.SummonStage = "FirePrompt"
		local ok, problem = pcall(fireproximityprompt, prompt, 0)
		if ok then Runtime.SummonStage = "Triggered" return true end
		Runtime.Stats.SummonFailures += 1
		return false, problem
	end

	local ok, problem = pcall(function()
		Runtime.SummonStage = "HoldBegin"
		prompt:InputHoldBegin()
		task.wait(math.max(0.12, prompt.HoldDuration + 0.05))
		prompt:InputHoldEnd()
	end)
	if ok then Runtime.SummonStage = "Triggered" Runtime.Stats.SummonRetries += 1 else Runtime.Stats.SummonFailures += 1 end
	return ok, problem
end

function Runtime:SummonOnce()
	return fireSummonPrompt()
end

local function hasLivingBoss()
	local plot = getPlayerPlot()
	local enemies = plot and plot:FindFirstChild("Enemies")
	if not enemies then return false end
	for _, enemy in ipairs(enemies:GetChildren()) do
		local kind = enemy:GetAttribute("EnemyType") or enemy:GetAttribute("Type")
		local health = tonumber(enemy:GetAttribute("Remaining")) or tonumber(enemy:GetAttribute("Health")) or 0
		if (kind == "Boss" or string.find(string.lower(enemy.Name), "boss", 1, true)) and health > 0 then return true end
	end
	return false
end

