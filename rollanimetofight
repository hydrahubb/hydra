local fastForwardToken = 0
local function setFastForward(target)
	target = math.clamp(math.floor(tonumber(target) or 1), 1, 2)
	fastForwardToken += 1
	local token = fastForwardToken
	task.spawn(function()
		for _ = 1, 2 do
			if not Runtime.Alive or token ~= fastForwardToken then return end
			local current = math.clamp(math.floor(tonumber(LocalPlayer:GetAttribute("FightFastForwardLevel")) or 1), 1, 2)
			if current == target then return end
			FightRemote:FireServer("FastForward")
			task.wait(0.3)
		end
	end)
end

local checkpointToken = 0
local function setCheckpoint(target)
	target = tonumber(target) or 0
	checkpointToken += 1
	local token = checkpointToken
	task.spawn(function()
		for _ = 1, 7 do
			if not Runtime.Alive or token ~= checkpointToken then return end
			if (tonumber(DataService:get({ "Settings", "Checkpoint" })) or 0) == target then return end
			CheckpointRemote:FireServer()
			task.wait(0.35)
		end
	end)
end

local function requestFunction()
	return (syn and syn.request) or http_request or request
end

local function sendWebhook(title, description, fields)
	if not flag("webhook.enabled", false) then return end
	local endpoint = tostring(flag("webhook.url", ""))
	local requestImpl = requestFunction()
	if endpoint == "" or type(requestImpl) ~= "function" then return end
	task.spawn(function()
		local payload = {
			username = "Hydra",
			embeds = {{
				title = title,
				description = description,
				color = 8159231,
				fields = fields or {},
				footer = { text = GAME_TITLE .. " • Hydra " .. SCRIPT_VERSION },
			}},
		}
		pcall(requestImpl, {
			Url = endpoint,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload),
		})
	end)
end

local function entryRarity(entry)
	local info = entry and characterInfo(entry.Name)
	return tostring((entry and entry.Rarity) or (info and info.Rarity) or "Common")
end

local function entryMatches(entry, availableGold)
	local price = tonumber(entry.Price) or 0
	local minimum = math.max(0, numberFlag("buy.minPrice", 0))
	local maximum = math.max(0, numberFlag("buy.maxPrice", 0))
	local keepGold = math.max(0, numberFlag("buy.keepGold", 0))
	if price < minimum or (maximum > 0 and price > maximum) or availableGold - price < keepGold then return false end
	if not selectionEmpty("buy.rarities") and not selected("buy.rarities", entryRarity(entry)) then return false end
	if not selectionEmpty("buy.characters") and not selected("buy.characters", tostring(entry.Name)) then return false end
	local mutation = tostring(entry.Mutation or "None")
	if mutation == "" then mutation = "None" end
	if not selectionEmpty("buy.mutations") and not selected("buy.mutations", mutation) then return false end
	return true
end

local function processRollPurchases(roll)
	if not Runtime.Alive or not flag("buy.enabled", false) then return end
	local rollKey = tostring(roll.Id)
	if Runtime.ProcessedRolls[rollKey] then return end
	Runtime.ProcessedRolls[rollKey] = true
	if flag("buy.stopFull", true) and inventoryFull(numberFlag("buy.inventoryBuffer", 0)) then return end

	local availableGold = getGold()
	local matches = {}
	for index, entry in pairs(roll.Entries) do
		if entryMatches(entry, availableGold) then table.insert(matches, { Index = index, Entry = entry }) end
	end
	local mode = flag("buy.mode", "All Matches")
	if mode == "Rarest Match" then
		table.sort(matches, function(a, b) return (rarityRank[entryRarity(a.Entry)] or 0) > (rarityRank[entryRarity(b.Entry)] or 0) end)
	elseif mode == "Cheapest Match" then
		table.sort(matches, function(a, b) return (tonumber(a.Entry.Price) or 0) < (tonumber(b.Entry.Price) or 0) end)
	end
	if mode ~= "All Matches" and #matches > 1 then matches = { matches[1] } end

	for _, match in ipairs(matches) do
		if not Runtime.Alive or Runtime.LastRoll ~= roll then return end
		local price = tonumber(match.Entry.Price) or 0
		if entryMatches(match.Entry, availableGold) then
			BuyRemote:FireServer(roll.Id, match.Index)
			Runtime.Stats.BuyAttempts += 1
			availableGold -= price
			task.wait(0.12)
		end
	end
end

Runtime:Add(RollRemote.OnClientEvent:Connect(function(player, plot, entries, movementTime, rollId)
	if player ~= LocalPlayer or type(entries) ~= "table" then return end
	local roll = { Id = rollId, Entries = entries, Plot = plot, ReceivedAt = os.clock() }
	Runtime.LastRoll = roll
	Runtime.Stats.Rolls += 1
	for _ in pairs(entries) do Runtime.Stats.UnitsSeen += 1 end
	local cooldown = summonCooldown()
	Runtime.NextRollAt = os.clock() + cooldown + (flag("buy.enabled", false) and 0.35 or 0.05)
	task.delay(serverSummonCooldown() + 0.03, function() processRollPurchases(roll) end)

	if flag("webhook.rolls", false) then
		local lines = {}
		for _, entry in pairs(entries) do table.insert(lines, entryRarity(entry) .. " • " .. tostring(entry.Name) .. " • $" .. tostring(entry.Price or 0)) end
		sendWebhook("Summon roll", table.concat(lines, "\n"))
	end
end))

Runtime:Add(BuyRemote.OnClientEvent:Connect(function(player, rollId, index)
	if player ~= LocalPlayer then return end
	Runtime.Stats.Purchases += 1
	local roll = Runtime.LastRoll
	local entry = roll and tostring(roll.Id) == tostring(rollId) and roll.Entries[index]
	if entry and flag("webhook.purchases", true) then
		sendWebhook("Unit purchased", entryRarity(entry) .. " • " .. tostring(entry.Name), {
			{ name = "Mutation", value = tostring(entry.Mutation or "None"), inline = true },
			{ name = "Price", value = "$" .. tostring(entry.Price or 0), inline = true },
		})
	end
end))

local function protectedInventoryItem(item)
	if flag("inventory.protectLocked", true) and item.isLocked == true then return true end
	if flag("inventory.protectEquipped", true) then
		local uuid = tostring(item.UUID or "")
		for _, equipped in ipairs(DataService:get("Equipped") or {}) do
			if uuid ~= "" and tostring(equipped.UUID or equipped.CharacterId or "") == uuid then return true end
		end
	end
	if selected("inventory.protectedCharacters", tostring(item.Name)) then return true end
	local mutation = tostring(item.Mutation or "None")
	if mutation == "" then mutation = "None" end
	if selected("inventory.protectedMutations", mutation) then return true end
	if item.Trait and item.Trait ~= "" and flag("inventory.protectTraits", true) then return true end
	return false
end

local function autoSellStep()
	if not flag("inventory.autoSell", false) then return end
	local batch = {}
	local now = os.clock()
	local maximum = math.clamp(math.floor(numberFlag("inventory.sellBatch", 20)), 1, 50)
	for _, item in ipairs(getInventory()) do
		local uuid = tostring(item.UUID or "")
		local info = characterInfo(item.Name)
		local rarity = tostring(item.Rarity or (info and info.Rarity) or "Common")
		if uuid ~= "" and selected("inventory.sellRarities", rarity) and not protectedInventoryItem(item) and (Runtime.PendingSell[uuid] or 0) <= now then
			table.insert(batch, uuid)
			Runtime.PendingSell[uuid] = now + 10
			if #batch >= maximum then break end
		end
	end
	if #batch > 0 then SellRemote:FireServer(batch) Runtime.Stats.SellBatches += 1 end
end

local function autoLockStep()
	if not flag("inventory.autoLock", false) then return end
	local changed = 0
	for _, item in ipairs(getInventory()) do
		local info = characterInfo(item.Name)
		local rarity = tostring(item.Rarity or (info and info.Rarity) or "Common")
		if item.UUID and item.isLocked ~= true and (selected("inventory.lockRarities", rarity) or selected("inventory.protectedCharacters", tostring(item.Name))) then
			InventoryRemote:FireServer("ToggleLocked", item.UUID)
			changed += 1
			if changed >= 5 then break end
			task.wait(0.12)
		end
	end
end

local function skillStep()
	if not flag("skills.enabled", false) or not isFighting() then return end
	if flag("skills.bossOnly", false) and not hasLivingBoss() then return end
	local plot = getPlayerPlot()
	local characters = plot and plot:FindFirstChild("Characters")
	if not characters then return end
	local now = workspace:GetServerTimeNow()
	local candidates = characters:GetChildren()
	table.sort(candidates, function(a, b) return (tonumber(a:GetAttribute("Slot")) or 99) < (tonumber(b:GetAttribute("Slot")) or 99) end)
	for _, model in ipairs(candidates) do
		local uuid = tostring(model:GetAttribute("UUID") or "")
		local name = tostring(model:GetAttribute("CharacterName") or model.Name)
		local cooldownEnd = tonumber(model:GetAttribute("ActiveSkillCooldownEnd")) or 0
		if uuid ~= "" and cooldownEnd <= now and (Runtime.PendingSkills[uuid] or 0) <= os.clock() then
			if selectionEmpty("skills.characters") or selected("skills.characters", name) then
				ActiveSkillRemote:FireServer(uuid)
				Runtime.PendingSkills[uuid] = os.clock() + math.max(0.5, numberFlag("skills.interval", 0.75))
				Runtime.Stats.SkillsUsed += 1
				return
			end
		end
	end
end

local upgradeMaximums = { Gold = 25, Luck = 25, Slots = 12, Inventory = 225 }
local upgradeNames = { "Gold", "Luck", "Slots", "Inventory" }
local function upgradeStep()
	if not flag("upgrades.enabled", false) then return end
	local gold = getGold()
	local keepGold = math.max(0, numberFlag("upgrades.keepGold", 0))
	local choices = {}
	for _, name in ipairs(upgradeNames) do
		if selected("upgrades.types", name) then
			local current = tonumber(DataService:get({ "Upgrades", name })) or tonumber(UpgradesInfo.Upgrades.Default[name]) or 0
			local rawPrice = UpgradesInfo.GetPrice(name, current)
			local price = tonumber(rawPrice) or math.huge
			if not UpgradesInfo.IsMaxed(name, current) and gold - price >= keepGold then
				table.insert(choices, { Name = name, Price = price, Progress = current / upgradeMaximums[name] })
			end
		end
	end
	if #choices == 0 then return end
	local priority = flag("upgrades.priority", "Balanced")
	if priority == "Balanced" then table.sort(choices, function(a, b) return a.Progress < b.Progress end)
	else table.sort(choices, function(a, b) return a.Name == priority and b.Name ~= priority end) end
	UpgradeRemote:FireServer("Gold", choices[1].Name)
end

local function itemStep()
	if not flag("items.enabled", false) then return end
	if flag("items.fightOnly", true) and not isFighting() then return end
	for _, item in ipairs(getItems()) do
		local amount = tonumber(item.amount or item.Amount or item.Quantity) or 0
		if amount > 0 and selected("items.names", tostring(item.Name)) then ItemUseRemote:FireServer(item.Name) return end
	end
end

