function Runtime:Add(connection)
	table.insert(self.Connections, connection)
	return connection
end

function Runtime:BeginTravel()
	self.TravelLocks += 1
end

function Runtime:EndTravel()
	self.TravelLocks = math.max(0, self.TravelLocks - 1)
end

function Runtime:IsTravelBusy()
	return self.TravelLocks > 0
end

function Runtime:Destroy()
	if not self.Alive then return end
	self.Alive = false
	for _, connection in ipairs(self.Connections) do pcall(function() connection:Disconnect() end) end
	table.clear(self.Connections)
	if type(setfpscap) == "function" then pcall(setfpscap, OriginalFpsCap) end
	if self.Hydra then pcall(function() self.Hydra:Destroy() end) end
	if env.__HYDRA_ROLL_ANIME_RUNTIME == self then env.__HYDRA_ROLL_ANIME_RUNTIME = nil end
end

